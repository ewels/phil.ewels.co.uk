---
import DarkModeToggle from "@components/DarkModeToggle.svelte";

import { Icon } from "astro-icon/components";

import { getLlmPages } from "../lib/llm-pages";

// A content page can offer its own Markdown source; the homepage and the index pages
// have no single source to offer, so they point at the site-wide index instead.
const pathname = Astro.url.pathname.replace(/\/$/, "");
const has_markdown = (await getLlmPages()).some((page) => page.path === pathname);
const markdown_href = has_markdown ? `${pathname}.md` : "/llms.txt";
---

<footer class="mt-8 block border-t py-6 text-center text-xs dark:border-zinc-700">
  <div class="inline text-zinc-400 dark:text-zinc-600">
    {/* Explicit spacers: prettier-plugin-astro 1.0 splits inline links onto their own
    lines and drops the significant whitespace before them, which runs the words together. */}
    Built using{" "}
    <a href="https://astro.build/" target="_blank" class="underline">
      Astro
    </a>{" "}
    and{" "}
    <a href="https://tailwindcss.com/" target="_blank" class="underline">
      TailwindCSS
    </a>
    <span class="mx-2 hidden md:inline">|</span>
    <br class="md:hidden" />
    <a href="https://github.com/ewels/phil.ewels.co.uk/" target="_blank">
      <span class="underline">See source code</span> <Icon name="mdi:github" size="24px" class="inline" />
    </a>
    <span class="mx-2 hidden md:inline">|</span>
    <br class="md:hidden" />
    <a href={markdown_href}>
      <span class="underline">Read as Markdown</span> <Icon name="simple-icons:markdown" size="24px" class="inline" />
    </a>
  </div>
  <div class="float-right mr-6 hidden text-black md:block dark:text-zinc-200">
    <DarkModeToggle client:only="svelte" />
  </div>
</footer>
